.wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.tip {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}
.tip.sub {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.log {
  font-size: 22rpx;
  color: #333;
  background: #f5f5f5;
  padding: 16rpx;
  border-radius: 8rpx;
  white-space: pre-wrap;
  max-height: 60vh;
  overflow-y: auto;
}
