.wp-page--alerts {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.al-loading,
.al-empty {
  text-align: center;
  padding: 48rpx 24rpx;
}

.al-intro-surface {
  margin-bottom: 24rpx;
}

.al-intro-title {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.al-intro-txt {
  font-size: 24rpx;
  line-height: 1.55;
  display: block;
}

.al-list {
  border-top: none;
  margin-top: 0;
  padding-top: 0;
}

.al-row {
  box-sizing: border-box;
  border-left: 6rpx solid transparent;
}

.al-row--danger {
  border-left-color: #c92539;
}

.al-row--warn {
  border-left-color: #fa8c16;
}

.al-row-inner {
  align-items: flex-start;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.al-actions {
  margin-top: 16rpx;
}

.al-ack-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 52rpx;
  border-radius: 12rpx;
  background: rgba(201, 37, 57, 0.08);
  color: #c92539;
  border: 1px solid rgba(201, 37, 57, 0.35);
}

.al-seg {
  width: 8rpx;
  align-self: stretch;
  min-height: 48rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.al-seg--danger {
  background: linear-gradient(180deg, #ff4d4f, #c92539);
}

.al-seg--warn {
  background: linear-gradient(180deg, #ffd666, #faad14);
}

.al-seg--info {
  background: linear-gradient(180deg, #d9d9d9, #8c8c8c);
}

.al-body {
  flex: 1;
  min-width: 0;
}

.al-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.al-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  min-width: 200rpx;
}

.al-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-tag, 8rpx);
  background: rgba(201, 37, 57, 0.12);
  color: #c92539;
  flex-shrink: 0;
}

.al-badge--warn {
  background: rgba(250, 173, 20, 0.18);
  color: #d48806;
}

.al-detail {
  margin-top: 10rpx;
  line-height: 1.55;
  font-size: 24rpx;
}

.al-expand-wrap {
  display: flex;
  justify-content: center;
  margin: 8rpx 0 24rpx;
}

.al-expand-btn {
  background: rgba(255, 255, 255, 0.95);
  color: #c92539;
  border: 1px solid rgba(201, 37, 57, 0.25);
  border-radius: var(--radius-btn, 16rpx);
  padding: 12rpx 40rpx;
  font-size: 26rpx;
}

.al-sub-card {
  padding: 28rpx 24rpx 36rpx;
}

.al-sub-btn {
  width: 100%;
}
