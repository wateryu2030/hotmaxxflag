<view class="wp-page wp-page--ops">
  <view class="da-card" wx:if="{{labor}}">
    <view class="wp-title">人力摘要</view>
    <view class="wp-muted" style="margin-top: 8rpx; margin-bottom: 8rpx">人效与四象限摘要</view>
    <view class="ops-kv">
      <text class="wp-muted">总人力成本</text>
      <text class="wp-num ops-val">{{labor.total_labor_cost}}</text>
    </view>
    <view class="ops-kv">
      <text class="wp-muted">人效(销/人)环比</text>
      <text
        class="wp-num ops-val {{(labor.sales_per_capita_link_ratio||0)>=0?'wp-success':'wp-warning'}}"
      >{{labor.sales_per_capita_link_ratio!=null?labor.sales_per_capita_link_ratio+'%':'—'}}</text>
    </view>
    <view class="wp-muted" style="margin-top: 16rpx; line-height: 1.5">{{labor.quadrant_summary}}</view>
  </view>

  <view class="da-card" wx:if="{{quad && quadHeat.length}}">
    <view class="wp-title" style="margin-bottom: 8rpx">低毛利 × 高人力</view>
    <text class="wp-muted" style="display: block; margin-bottom: 16rpx; font-size: 24rpx"
    >色深表示毛利偏低风险越高；点方块或列表行进入「品类下钻」</text>
    <view class="ops-heat-mx">
      <view
        wx:for="{{quadHeat}}"
        wx:for-index="hi"
        wx:key="_k"
        class="ops-heat-cell"
        style="{{item._heatStyle}}"
        data-i="{{hi}}"
        bindtap="onQuadHeatCell"
      >
        <text class="ops-heat-lab">{{item.category}}</text>
        <text class="ops-heat-pct wp-num">{{item.margin_pct}}%</text>
      </view>
    </view>
    <view
      class="ops-list-fallback da-list"
      style="border-top: 1px solid rgba(0,0,0,0.06); margin-top: 16rpx; padding-top: 12rpx"
    >
      <view
        wx:for="{{quadHeat}}"
        wx:for-index="qi"
        wx:key="_k"
        class="da-row"
        data-i="{{qi}}"
        bindtap="onQuadListDrill"
      >
        <view class="da-row-bg" style="width: {{item._bgPct}}%;" />
        <view class="da-row-inner">
          <view
            wx:if="{{qi<3}}"
            class="wp-rank {{qi===0?'wp-rank--1':''}} {{qi===1?'wp-rank--2':''}} {{qi===2?'wp-rank--3':''}}"
          >{{qi+1}}</view>
          <view wx:else class="da-rank-plain">{{qi+1}}</view>
          <view class="ops-list-mid">
            <text class="ops-cat-name">{{item.category}}</text>
          </view>
          <text class="ops-list-pct wp-num da-val">{{item.margin_pct}}%</text>
        </view>
      </view>
    </view>
    <view class="wp-muted" style="margin-top: 12rpx; font-size: 24rpx">{{quad.hint}}</view>
  </view>

  <view class="da-card" wx:elif="{{quad && !(quadHeat && quadHeat.length)}}">
    <view class="wp-title">低毛利高人力</view>
    <view class="wp-muted">当前区间无符合条件的类目</view>
  </view>

  <view class="da-card" wx:if="{{inv}}">
    <view class="wp-title">库存</view>
    <view class="ops-kv">
      <text class="wp-muted">总库存额</text>
      <text class="wp-num ops-val">{{inv.inventory_total}}</text>
    </view>
    <view class="wp-muted" style="margin-top: 8rpx; font-size: 24rpx">{{inv.note}}</view>
    <block wx:if="{{inv.low_stock_items && inv.low_stock_items.length}}">
      <view class="inv-head">
        <text class="wp-muted">低库存 SKU（qty&lt;5）</text>
        <text
          wx:if="{{inv.low_stock_items.length > 3}}"
          class="inv-toggle"
          bindtap="toggleInv"
        >{{invExpanded ? '收起' : '查看全部'}}</text>
      </view>
      <view
        wx:for="{{invDisplayItems}}"
        wx:key="_k"
        class="da-row"
      >
        <view class="da-row-bg" style="width: {{item._bgPct}}%;" />
        <view class="da-row-inner inv-d-row">
          <view class="inv-mark" />
          <view class="inv-row-txt">
            <text class="wp-num">{{item.sku_code}}</text>
            <text class="wp-muted"> · 库存 {{item.stock_qty}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="htma-row-btns wp-ops-btns">
    <button class="htma-btn-primary wp-btn-primary" bindtap="goAlerts">预警中心与订阅</button>
    <button class="wp-btn-ghost" bindtap="goLaborWeb">完整人力分析 (Web)</button>
  </view>
  <security-watermark />
</view>
