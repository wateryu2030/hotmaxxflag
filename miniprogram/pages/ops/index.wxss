.ops-kv {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 20rpx;
}

.ops-val {
  font-size: 30rpx;
  font-weight: 600;
}

.ops-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  font-size: 26rpx;
}

.inv-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
}

.inv-toggle {
  font-size: 24rpx;
  color: #c92539;
  padding: 8rpx 16rpx;
}

.inv-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(250, 173, 20, 0.06);
  border-radius: 16rpx;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.inv-mark {
  width: 8rpx;
  align-self: stretch;
  min-height: 40rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  background: linear-gradient(180deg, #ffd666, #faad14);
  flex-shrink: 0;
}

.inv-row-txt {
  flex: 1;
  font-size: 26rpx;
}
.inv-d-row {
  min-height: 72rpx;
  align-items: center;
  padding: 12rpx 20rpx 12rpx 12rpx;
}

/* 热力矩阵 */
.ops-heat-mx {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 0 0 4rpx;
}
.ops-heat-cell {
  width: calc(33.33% - 6rpx);
  min-width: 160rpx;
  flex: 1 0 160rpx;
  max-width: 100%;
  min-height: 100rpx;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.ops-heat-lab {
  font-size: 22rpx;
  color: #1f2937;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.ops-heat-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.78);
  align-self: flex-end;
}
.ops-list-mid {
  flex: 1;
  min-width: 0;
  margin: 0 8rpx;
}
.ops-cat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}
.ops-list-pct {
  color: #c92539;
  font-size: 28rpx;
  flex-shrink: 0;
}
.wp-page--ops {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.htma-row-btns.wp-ops-btns {
  padding: 8rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
