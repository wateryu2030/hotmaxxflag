<view class="wp-page wp-page--home">
  <view class="home-ticker" wx:if="{{tickerItems.length}}">
    <scroll-view
      class="home-ticker-scroll"
      scroll-x="{{true}}"
      show-scrollbar="{{false}}"
      enhanced="{{true}}"
    >
      <view class="home-ticker-track">
        <text
          wx:for="{{tickerItems}}"
          wx:key="_k"
          class="home-ticker-item"
        >● {{item.line}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="da-filter-surface">
    <view class="da-capsule-wrap">
      <view class="da-capsule home-cycle">
        <view
          wx:for="{{cycleLabels}}"
          wx:for-index="ci"
          wx:key="id"
          class="da-cap {{cycleIndex===ci?'da-cap--on':''}}"
          data-i="{{ci}}"
          bindtap="onPickCycleCap"
        >{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{kpiCycle==='custom'}}" class="home-custom-dates">
      <picker mode="date" value="{{customRange.start}}" bindchange="onStart"><view class="home-date-pill">始 {{customRange.start || '选'}}</view></picker>
      <picker mode="date" value="{{customRange.end}}" bindchange="onEnd"><view class="home-date-pill">止 {{customRange.end || '选'}}</view></picker>
      <button class="home-date-apply" size="mini" bindtap="applyCustom">应用</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="htma-center wp-muted">加载中…</view>

  <block wx:else>
    <view class="da-card" wx:if="{{ov}}">
      <view class="home-kpi-head">
        <view class="wp-title">核心 KPI</view>
        <text class="wp-muted home-asof" wx:if="{{asOf}}">截止 {{asOf}}</text>
      </view>
      <view class="home-kpi-grid">
        <view class="home-kpi-tile">
          <view class="home-kpi-ico home-kpi-ico--sale" />
          <text class="home-kpi-lab">销售额(万)</text>
          <text class="home-kpi-val wp-num">{{ov._saleWan}}</text>
          <view class="home-kpi-trend" wx:if="{{ov.sales_link_ratio != null}}">
            <text class="home-kpi-ar {{(ov.sales_link_ratio||0)>=0?'tr-up':'tr-down'}}">{{(ov.sales_link_ratio||0)>=0?'▲':'▼'}}</text>
            <text class="wp-num home-kpi-trend-n {{(ov.sales_link_ratio||0)>=0?'tr-up':'tr-down'}}">{{ov.sales_link_ratio}}%</text>
          </view>
        </view>
        <view class="home-kpi-tile">
          <view class="home-kpi-ico home-kpi-ico--profit" />
          <text class="home-kpi-lab">毛利(万)</text>
          <text class="home-kpi-val wp-num home-kpi-val--green">{{ov._profWan}}</text>
          <view class="home-kpi-trend" wx:if="{{ov.profit_link_ratio != null}}">
            <text class="home-kpi-ar {{(ov.profit_link_ratio||0)>=0?'tr-up':'tr-down'}}">{{(ov.profit_link_ratio||0)>=0?'▲':'▼'}}</text>
            <text class="wp-num home-kpi-trend-n {{(ov.profit_link_ratio||0)>=0?'tr-up':'tr-down'}}">{{ov.profit_link_ratio}}%</text>
          </view>
        </view>
        <view class="home-kpi-tile">
          <view class="home-kpi-ico home-kpi-ico--rate" />
          <text class="home-kpi-lab">毛利率</text>
          <text class="home-kpi-val wp-num">{{ov.avg_margin}}%</text>
        </view>
        <view class="home-kpi-tile">
          <view class="home-kpi-ico home-kpi-ico--inv" />
          <text class="home-kpi-lab">库存额(万)</text>
          <text class="home-kpi-val wp-num">{{ov._invWan}}</text>
        </view>
      </view>
      <text class="wp-muted home-kpi-lag" wx:if="{{statsLagNote}}">{{statsLagNote}}</text>
    </view>

    <view class="da-card home-ai-card">
      <view class="home-ai-head">
        <view class="wp-title">AI 经营建议</view>
        <text class="wp-muted home-ai-date" wx:if="{{aiReportDate}}">{{aiReportDate}}</text>
      </view>
      <view class="home-ai-body wp-muted">
        <text class="home-ai-text" user-select wx:if="{{aiReport || aiTyping}}">{{aiReport}}</text>
        <text class="home-ai-cursor" wx:if="{{aiTyping}}">|</text>
        <text wx:if="{{!aiReport && !aiTyping && !aiReportFull}}" class="home-ai-empty">暂无快报，可由服务端定时任务生成。</text>
      </view>
      <button class="htma-btn-primary wp-btn-primary home-ai-btn" bindtap="goAttribution">查看归因详情</button>
    </view>

    <view class="da-card home-sig-card" wx:if="{{sigCard && sigCard.loaded}}">
      <view class="home-sig-head">
        <view class="wp-title">经营智能信号</view>
      </view>
      <text class="wp-muted home-sig-sub">大类毛利率 Z（相对自身历史）· 全店销额 7 日均线动量</text>
      <view class="home-plain-line home-sig-line" wx:if="{{sigCard.slope != null}}">
        7 日均线动量：<text class="wp-num {{sigCard.slopeCls}}">{{sigCard.slope}}%</text>
        <text class="wp-muted">（相对前一 7 日均）</text>
      </view>
      <view class="home-plain-line home-sig-line wp-muted" wx:else>均线动量：需约 14 个以上有销日方有读数</view>
      <text class="wp-muted home-sig-meta" wx:if="{{sigCard.metaLine}}">{{sigCard.metaLine}}</text>
      <view wx:if="{{sigCard.rows.length}}" class="da-list home-sig-list">
        <view class="wp-muted home-sig-list-hd">毛利率偏低（统计异常）</view>
        <view
          wx:for="{{sigCard.rows}}"
          wx:key="_k"
          class="da-row"
        >
          <view class="da-row-bg" style="width: {{item._bgPct}}%;" />
          <view class="da-row-inner home-sig-row">
            <text class="home-sig-name">{{item.category_large}}</text>
            <text class="wp-num home-sig-z tr-down">Z {{item.zscore_margin}}</text>
            <text class="wp-num home-sig-m">毛利 {{item.latest_margin_pct}}%</text>
          </view>
        </view>
      </view>
      <view wx:else class="wp-muted home-sig-empty">当前窗口暂无大类进入「低毛利 Z」名单（已按销额门槛过滤）。</view>
    </view>

    <view class="da-card" wx:if="{{ov && ov.trend}}">
      <view class="wp-title" style="margin-bottom:8rpx">近5日 & 最近一日</view>
      <view class="home-plain-line">5日销额(元)：<text class="wp-num">{{ov.trend.last_5_days_sales}}</text></view>
      <view class="home-plain-line">5日毛利(元)：<text class="wp-num">{{ov.trend.last_5_days_profit}}</text></view>
      <view class="home-plain-line">最近日 {{ov.trend.latest_date}} 销额：<text class="wp-num">{{ov.trend.latest_sales}}</text></view>
    </view>

    <view class="da-card" wx:if="{{ov && ov.yoy}}">
      <view class="wp-title" style="margin-bottom:8rpx">同比</view>
      <text class="wp-muted" style="display:block;margin-bottom:8rpx">{{ov.yoy.note || ' '}}</text>
      <view class="home-plain-line">销额同比：<text class="wp-num {{(ov.yoy.sales_yoy||0)>=0?'tr-up':'tr-down'}}">{{ov.yoy.sales_yoy!=null?ov.yoy.sales_yoy+'%':'—'}}</text></view>
      <view class="home-plain-line">毛利同比：<text class="wp-num {{(ov.yoy.profit_yoy||0)>=0?'tr-up':'tr-down'}}">{{ov.yoy.profit_yoy!=null?ov.yoy.profit_yoy+'%':'—'}}</text></view>
    </view>

    <view class="da-card" wx:if="{{ov && ov.weekday_compare && ov.weekday_compare.length}}">
      <view class="wp-title" style="margin-bottom:8rpx">周中销售（周一=1）</view>
      <view class="da-list" style="border-top: none; padding-top: 0; margin-top: 0">
        <view
          wx:for="{{ov.weekday_compare}}"
          wx:key="weekday"
          class="da-row"
        >
          <view class="da-row-bg" style="width: {{item._bgPct}}%;" />
          <view class="da-row-inner home-wd-row">
            <text class="home-wd-lab">周{{item.weekday}}</text>
            <view class="home-wd-bar">
              <view class="wp-progress-track home-wd-track">
                <view class="wp-progress-fill" style="width:{{item._pct}}%" />
              </view>
            </view>
            <text class="home-wd-val wp-num">{{item.sales}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="home-quick da-card">
      <view class="home-quick-hd">快捷分析</view>
      <view class="home-quick-row" hover-class="home-quick-row--hover" bindtap="goCats">
        <view class="home-quick-left">
          <view class="home-quick-ico home-quick-ico--pie" />
          <view class="home-quick-txt">
            <text class="home-quick-title">品类分析</text>
            <text class="home-quick-sub">占比 · 热力 · 贡献 · 下钻</text>
          </view>
        </view>
        <text class="home-quick-arrow">›</text>
      </view>
      <view class="home-quick-divider" />
      <view class="home-quick-row" hover-class="home-quick-row--hover" bindtap="goInsight">
        <view class="home-quick-left">
          <view class="home-quick-ico home-quick-ico--line" />
          <view class="home-quick-txt">
            <text class="home-quick-title">趋势洞察</text>
            <text class="home-quick-sub">多粒度曲线与数据列表</text>
          </view>
        </view>
        <text class="home-quick-arrow">›</text>
      </view>
    </view>
  </block>
  <security-watermark />
</view>
