<view class="wp-page feishu-web-page" wx:if="{{!src}}">
  <view class="htma-card">
    <text class="htma-title">飞书登录</text>
    <text class="htma-muted feishu-web-tip">当前未配置以 https 开头的服务器地址，无法在小程序内打开网页。</text>
    <text class="htma-muted feishu-web-tip">请在 app.js 的 globalData.baseUrl 中填写看板域名（与微信公众平台「业务域名」一致），或复制下方链接到系统浏览器打开。</text>
  </view>
  <button wx:if="{{boardUrl}}" class="htma-btn-primary wp-btn-primary" bindtap="copyBoardUrl">复制看板登录页链接</button>
</view>
<web-view wx:else src="{{src}}"></web-view>
