<view class="wp-page wp-page--tool">
  <view class="da-filter-surface ai-surface">
    <view class="wp-title">AI 经营建议</view>
    <text class="wp-muted ai-intro">以下为模型生成内容，请结合实际经营判断</text>
  </view>
  <view class="da-card ai-card">
    <text class="ai-body" user-select>{{text}}</text>
  </view>
  <button class="htma-btn-primary wp-btn-primary ai-refresh" bindtap="refresh">刷新</button>
  <security-watermark />
</view>
