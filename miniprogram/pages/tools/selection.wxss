.wp-page--tool {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.sel-surface {
  margin-bottom: 20rpx;
}

.sel-note {
  line-height: 1.55;
  font-size: 24rpx;
}

.sel-row {
  min-height: 0;
}

.sel-inner {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 20rpx 18rpx;
}

.sel-main {
  width: 100%;
}

.tool-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #1a1a1a);
}

.tool-item-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.tool-bar-block {
  margin-top: 16rpx;
}

.tool-bar-lab {
  font-size: 22rpx;
  color: var(--text-muted, #8c93a1);
}

.tool-track {
  margin-top: 8rpx;
  height: 10rpx;
}

.tool-bar-pct {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted, #8c93a1);
  text-align: right;
}

.tool-fill-margin {
  background: linear-gradient(90deg, #95de64, #52c41a);
}
