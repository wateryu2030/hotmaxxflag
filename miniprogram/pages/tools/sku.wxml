<view class="wp-page wp-page--tool">
  <view class="da-filter-surface tool-surface">
    <view class="wp-title tool-surface-title">商品档案搜索</view>
    <input class="tool-input" placeholder="编码或名称" value="{{kw}}" bindinput="onIn" />
    <button class="htma-btn-primary wp-btn-primary tool-search-btn" bindtap="search">搜索</button>
  </view>

  <view
    wx:for="{{items}}"
    wx:key="sku_code"
    class="da-row tool-sku-row"
  >
    <view class="da-row-bg" style="width: {{item._bgPct}}%;" />
    <view class="da-row-inner tool-sku-inner">
      <view class="tool-sku-main">
        <view class="tool-item-title">{{item.name}} ({{item.sku_code}})</view>
        <view class="wp-muted tool-item-meta">销 {{item.sale_amount}} · 毛 {{item.gross_profit}} · 毛利率 {{item.margin_pct}}%</view>
        <view class="tool-bar-block">
          <text class="tool-bar-lab">销额（本页相对）</text>
          <view class="wp-progress-track tool-track">
            <view class="wp-progress-fill" style="width:{{item._saleBar}}%;"></view>
          </view>
          <text class="wp-num tool-bar-pct">{{item._saleBar}}%</text>
        </view>
        <view class="tool-bar-block">
          <text class="tool-bar-lab">毛利率</text>
          <view class="wp-progress-track tool-track">
            <view class="wp-progress-fill tool-fill-margin" style="width:{{item._marginBar}}%;"></view>
          </view>
          <text class="wp-num tool-bar-pct">{{item._marginBar}}%</text>
        </view>
      </view>
    </view>
  </view>
  <security-watermark />
</view>
